; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Castlevania-Remake"
run/main_scene="uid://jtfpsakmwh2w"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://b10eyif3e1eab"

[audio]

buses/default_bus_layout="uid://b472naenmbv7x"

[autoload]

AudioManager="*uid://d373te4dm335i"
Ui="*uid://ce4kksle0ku3l"
SignalManager="*uid://duo3pmms5tyuk"
ItemController="*uid://bdohul6s11p6e"

[display]

window/size/viewport_width=256
window/size/viewport_height=240
window/size/window_width_override=768
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Audio/": "green",
"res://Scenes/": "purple",
"res://Scripts/": "blue",
"res://Scripts/Items/Heal/": "red",
"res://Scripts/Items/Hearts/": "blue",
"res://Scripts/Items/Point/": "red",
"res://Scripts/Items/Special/": "red",
"res://Scripts/Items/Weapons/": "red",
"res://Scripts/Items/Wip/": "orange",
"res://Shaders/": "red"
}

[filesystem]

import/blender/enabled=false

